# Groww TOTP credentials (https://groww.in/trade-api/api-keys -> "Generate TOTP token")
TOTP_TOKEN=your_totp_api_key
TOTP_QR=YOUR_BASE32_TOTP_SECRET

# groww = live Groww market data (needs an active Trading API subscription)
# mock  = synthetic demo data for local development
DATA_SOURCE=groww

# Optional overrides
# ONLY_MARKET_HOURS=true
# LOOKBACK_DAYS=5
# LOG_LEVEL=INFO
